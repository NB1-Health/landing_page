{
  "name": "new-landing-page",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/remove-stale-seo-artifacts.mjs",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "predev": "node scripts/remove-stale-seo-artifacts.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && npm run build && npm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "db:sync-stg": "bash scripts/sync-from-stg.sh",
    "db:check-drift": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/check-schema-drift.ts",
    "db:resync-snapshot": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/resync-snapshot.ts",
    "seed:journal": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed-journal.ts",
    "seed:hubs": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed-hubs.ts",
    "seed:pillars": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed-pillars.ts",
    "seed:lexicon": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed-lexicon.ts",
    "deploy:guard": "node scripts/check-production-deploy-safety.mjs",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:down": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:down",
    "migrate:fresh": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:fresh",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "migrate:reset": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:reset",
    "postinstall": "patch-package && node scripts/patch-payload-block-ui.mjs",
    "seo:check": "node scripts/check-international-seo.mjs",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation npm install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm package-lock.json && npm install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" npx playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "check:seo": "node scripts/check-journal-seo.mjs",
    "check:locales": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/check-locales.ts",
    "dump:jsonld": "node scripts/dump-jsonld.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@next/third-parties": "^16.1.7",
    "@payloadcms/admin-bar": "3.82.1",
    "@payloadcms/db-postgres": "3.82.1",
    "@payloadcms/live-preview": "3.82.1",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/plugin-form-builder": "3.82.1",
    "@payloadcms/plugin-nested-docs": "3.82.1",
    "@payloadcms/plugin-redirects": "3.82.1",
    "@payloadcms/plugin-search": "3.82.1",
    "@payloadcms/plugin-seo": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "firebase": "^12.14.0",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "^0.378.0",
    "next": "15.4.11",
    "next-sitemap": "^4.2.3",
    "node-html-parser": "^7.1.0",
    "payload": "3.82.1",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "7.45.4",
    "react-phone-number-input": "^3.4.17",
    "sharp": "0.34.2",
    "slugify": "^1.6.6",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.5.4",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "copyfiles": "^2.4.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.11",
    "jsdom": "26.1.0",
    "patch-package": "^8.0.1",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.3",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "npm": ">=8.0.0"
  }
}
