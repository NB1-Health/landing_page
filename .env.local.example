# ============================================================
# ENVIRONMENT LOCAL - Copiaza acest fisier in .env si completeaza
# ============================================================
# ATENTIE: Nu conecta niciodata local la DATABASE_URL din STG sau PROD!

# Local PostgreSQL (pornit cu: docker compose up -d)
DATABASE_URL=postgresql://payload:payload@localhost:5432/landing_page_local

# Genereaza un secret random: openssl rand -hex 32
PAYLOAD_SECRET=dev_secret_schimba_asta

# Local dev
DEPLOY_ENV=local
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Local checkout backend. Keep this pointed at localhost while testing offers so a
# browser session cannot create Stripe or subscription state in staging by mistake.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Use a Stripe test-mode publishable key from the matching local backend environment.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Keep the current landing Meta Purchase CAPI sender until the backend outbox is live and verified.
# Change to "backend" only as the final CAPI cutover step; the browser Pixel remains enabled.
NEXT_PUBLIC_META_PURCHASE_OWNER=landing

# Production Klaviyo account. Leave blank locally and on staging.
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=

# Nu sunt necesare in local. PREVIEW_SECRET must be at least 32 characters.
CRON_SECRET=dev_cron_secret
PREVIEW_SECRET=dev_preview_secret_32_characters_minimum

# SMTP local (optional - pentru email dev poti folosi Mailpit sau Mailtrap)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=dev@localhost.com
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost.com

# Chatwoot (optional in local)
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=
NEXT_PUBLIC_CHATWOOT_BASE_URL=

# Enable only after installing the guards in docs/marketing-cache-rollout.md.
MARKETING_EDGE_CACHE_ENABLED=false
# Optional exact path list; omitted defaults to locale homepages.
# MARKETING_EDGE_CACHE_PATHS=/en,/de,/fr,/nl,/it,/ch,/be,/uk,/uae
